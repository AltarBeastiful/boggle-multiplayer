# Copiez ce fichier en .env sur le serveur : cp .env.example .env
# .env n'est pas suivi par git, un `git pull` ne l'écrasera pas.

# Port publié sur l'hôte : le jeu répond sur http://<serveur>:<BOGGLE_PORT>
BOGGLE_PORT=3001

# Nom de domaine, utilisé seulement si vous activez les labels Traefik
# dans docker-compose.yml. Il doit pointer (DNS) vers ce serveur.
BOGGLE_HOST=boggle.example.com
