# Copiez ce fichier en .env sur le serveur : cp .env.example .env
# .env n'est pas suivi par git, un `git pull` ne l'écrasera pas.

# Nom de domaine servi en HTTPS. Il doit pointer vers ce serveur : Let's Encrypt
# vérifie le domaine en se connectant au port 443.
#
# Sans nom de domaine, sslip.io et nip.io résolvent gratuitement n'importe quelle
# adresse IP, sans inscription ni configuration :
#   193-122-4-195.sslip.io  ->  193.122.4.195
#   193.122.4.195.nip.io    ->  193.122.4.195
BOGGLE_HOST=193-122-4-195.sslip.io

# Adresse utilisée par Let's Encrypt pour prévenir de l'expiration d'un certificat.
ACME_EMAIL=r3m1.benoit@gmail.com

# Port de diagnostic, sur la boucle locale du serveur uniquement.
BOGGLE_PORT=3001
