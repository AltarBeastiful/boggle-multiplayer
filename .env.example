# Copy this file to .env on the server: cp .env.example .env
# .env is not tracked by git, so a `git pull` will not overwrite it.

# Domain name served over HTTPS. It must point at this server: Let's Encrypt
# checks the domain by connecting to port 443.
#
# Without a domain name, sslip.io and nip.io resolve any IP address for free,
# with no registration and no configuration:
#   boggle-multiplayer.193-122-4-195.sslip.io  ->  193.122.4.195
#   193.122.4.195.nip.io    ->  193.122.4.195
BOGGLE_HOST=boggle-multiplayer.193-122-4-195.sslip.io

# Address Let's Encrypt uses to warn about an expiring certificate.
ACME_EMAIL=r3m1.benoit@gmail.com

# Trace of a found word on the grid, frozen when the client is built.
# `off` removes any highlight when a word is accepted.
VITE_WORD_TRACE=on

# Diagnostic port, on the server loopback only.
BOGGLE_PORT=3001
