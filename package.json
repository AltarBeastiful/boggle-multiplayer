{
  "name": "boggle-multiplayer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Boggle multijoueur en temps réel, règles et variantes de boggle.fr",
  "workspaces": [
    "packages/shared",
    "server",
    "client"
  ],
  "scripts": {
    "predev": "npm run build -w @boggle/shared",
    "dev": "concurrently -n shared,server,client -c gray,green,cyan \"npm run dev -w @boggle/shared\" \"npm run dev -w @boggle/server\" \"npm run dev -w @boggle/client\"",
    "build": "npm run build -w @boggle/shared && npm run build -w @boggle/client && npm run build -w @boggle/server",
    "start": "node server/dist/index.js",
    "test": "npm run test -w @boggle/shared",
    "typecheck": "tsc -b packages/shared server client",
    "test:trace": "node scripts/test-trace.mjs",
    "test:feedback": "node scripts/test-feedback.mjs",
    "test:round": "node scripts/test-round-end.mjs",
    "test:daily": "node scripts/test-daily.mjs",
    "test:awards": "node scripts/test-awards.mjs",
    "test:restart": "node scripts/test-restart.mjs",
    "test:dict": "node scripts/test-dictionary.mjs",
    "test:defs": "node scripts/test-definitions.mjs",
    "audit:mobile": "node scripts/audit-mobile.mjs",
    "audit:dict": "node scripts/audit-dictionary.mjs",
    "lexicon": "node scripts/build-lexicon.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "dictionary-fr": "^3.0.0",
    "hunspell-reader": "^10.0.1",
    "playwright": "^1.62.1",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
